# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API Keys / Data API).

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY. Never commit it or share it.
SUPABASE_SECRET_KEY=
